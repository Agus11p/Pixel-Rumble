# Copiar a .env.local y completar con los datos del proyecto de Supabase.
# Settings -> API en el panel de Supabase.
#
# Estas dos variables son PUBLICAS por diseno: viajan en el bundle del navegador.
# La SERVICE ROLE KEY nunca va aca ni en ningun archivo del frontend.

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anon-publica
